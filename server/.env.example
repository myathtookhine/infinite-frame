# ==========================================
# INFINITE FRAME - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# OPTION 1: Supabase (Production)
# ==========================================
# Get this from: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ==========================================
# OPTION 2: Local PostgreSQL (Development)
# ==========================================
# Comment out DATABASE_URL above and use these instead
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=infinite_frame
# DB_PASSWORD=your_local_password
# DB_PORT=5432

# ==========================================
# JWT Secret (for authentication)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here

# ==========================================
# Email (Nodemailer)
# ==========================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development
